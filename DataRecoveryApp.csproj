<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>DataRecoveryApp</RootNamespace>
    <AssemblyName>DataRecoveryApp</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Linux/macOS üzerinde de derlenebilmesi için -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>0.1.0</Version>
    <Product>Veri Kurtarma</Product>
    <Description>Silinen dosyaları kurtarma aracı (Faz 1)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
