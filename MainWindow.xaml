<Window x:Class="DataRecoveryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DataRecoveryApp.ViewModels"
        xmlns:models="clr-namespace:DataRecoveryApp.Models"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Veri Kurtarma" Height="720" Width="1280" MinWidth="950" MinHeight="560"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Üst bar ═══ -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🔍 Veri Kurtarma" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding AppVersion}" Foreground="{StaticResource MutedBrush}"
                           Margin="10,0,0,2" VerticalAlignment="Bottom"/>
                <TextBlock Text="{Binding EngineStatus}" Foreground="{StaticResource MutedBrush}"
                           Margin="14,0,0,2" VerticalAlignment="Bottom" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- ═══ Ana içerik (Sol | Orta | Sağ Önizleme) ═══ -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- SOL PANEL: Sürücüler -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="8" Margin="0,0,8,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                        <Button DockPanel.Dock="Right" Content="⟳" ToolTip="Sürücüleri yenile"
                                Padding="8,2" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshDrivesCommand}"/>
                        <TextBlock Text="Sürücüler" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button Content="▶  Tara" Command="{Binding StartScanCommand}"/>
                        <Button Content="✖  İptal" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelScanCommand}"/>
                        <Separator Background="{StaticResource BorderBrush}" Margin="0,6"/>
                        <Button Content="🔍  Veri Kazıma Başlat" Style="{StaticResource GreenButton}"
                                Command="{Binding StartCarvingCommand}"
                                ToolTip="İmza tabanlı (magic bytes) arama ile gizli dosyaları bul"/>
                        <Button Content="💾  Disk İmajı Oluştur" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CreateImageCommand}"
                                ToolTip="Sürücünün tamamını .img dosyasına yedekle"/>
                        <Button Content="🗂  Bölüm Analizi" Style="{StaticResource SecondaryButton}"
                                Command="{Binding AnalyzePartitionsCommand}"
                                ToolTip="Fiziksel diskin MBR/GPT bölüm tablosunu oku ve kayıp bölümleri ara"/>
                        <Button Content="📊  Rapor Dışa Aktar" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ExportReportCommand}"
                                ToolTip="Tarama sonuçlarını HTML veya CSV olarak kaydet"/>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive, Mode=TwoWay}"
                             BorderThickness="0" Margin="0,0,0,4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DriveViewModel}">
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding DisplayText}" FontSize="11"
                                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ORTA PANEL: Filtreler + DataGrid -->
            <DockPanel Grid.Column="1" Margin="0,0,8,0">

                <!-- Filtre + seçim butonları -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="☑ Tümünü Seç" Style="{StaticResource SecondaryButton}"
                                Command="{Binding SelectAllCommand}" Padding="8,5"/>
                        <Button Content="☐ Seçimi Temizle" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ClearSelectionCommand}" Padding="8,5"/>
                    </StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <Button Content="Hepsi"       Command="{Binding SetCategoryCommand}" CommandParameter="Hepsi"    Padding="10,5"/>
                        <Button Content="🖼 Resimler"  Command="{Binding SetCategoryCommand}" CommandParameter="Resimler" Padding="10,5"/>
                        <Button Content="📄 Belgeler"  Command="{Binding SetCategoryCommand}" CommandParameter="Belgeler" Padding="10,5"/>
                        <Button Content="🎬 Videolar"  Command="{Binding SetCategoryCommand}" CommandParameter="Videolar" Padding="10,5"/>
                        <Button Content="🎵 Müzik"     Command="{Binding SetCategoryCommand}" CommandParameter="Müzik"    Padding="10,5"/>
                        <Button Content="📁 Diğer"     Command="{Binding SetCategoryCommand}" CommandParameter="Diğer"    Padding="10,5"/>
                        <TextBlock VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{StaticResource MutedBrush}">
                            <Run Text="Filtre:"/><Run Text="{Binding SelectedCategory, Mode=OneWay}"/>
                        </TextBlock>
                    </WrapPanel>
                </DockPanel>

                <!-- Carving seçenekleri (ShowCarvingOptions true ise görünür) -->
                <GroupBox DockPanel.Dock="Top" Header="🔍 Veri Kazıma Formatları"
                          Margin="0,0,0,6"
                          Visibility="{Binding ShowCarvingOptions, Converter={StaticResource BoolToVis}}">
                    <WrapPanel>
                        <CheckBox Content="PNG"  IsChecked="{Binding CarverSettings.PNG}"/>
                        <CheckBox Content="JPEG" IsChecked="{Binding CarverSettings.JPEG}"/>
                        <CheckBox Content="GIF"  IsChecked="{Binding CarverSettings.GIF}"/>
                        <CheckBox Content="BMP"  IsChecked="{Binding CarverSettings.BMP}"/>
                        <CheckBox Content="TIFF" IsChecked="{Binding CarverSettings.TIFF}"/>
                        <CheckBox Content="PDF"  IsChecked="{Binding CarverSettings.PDF}"/>
                        <CheckBox Content="ZIP"  IsChecked="{Binding CarverSettings.ZIP}"/>
                        <CheckBox Content="RAR"  IsChecked="{Binding CarverSettings.RAR}"/>
                        <CheckBox Content="7Z"   IsChecked="{Binding CarverSettings.SevenZ}"/>
                        <CheckBox Content="DOCX" IsChecked="{Binding CarverSettings.DOCX}"/>
                        <CheckBox Content="XLSX" IsChecked="{Binding CarverSettings.XLSX}"/>
                        <CheckBox Content="PPTX" IsChecked="{Binding CarverSettings.PPTX}"/>
                        <CheckBox Content="MP4"  IsChecked="{Binding CarverSettings.MP4}"/>
                        <CheckBox Content="EXE"  IsChecked="{Binding CarverSettings.EXE}"/>
                        <CheckBox Content="Diğer" IsChecked="{Binding CarverSettings.Other}"/>
                    </WrapPanel>
                </GroupBox>

                <!-- Bölüm analizi sonuçları -->
                <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6"
                        Padding="8" Margin="0,0,0,6"
                        Visibility="{Binding ShowPartitionPanel, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="✖ Kapat" Padding="8,2"
                                    Style="{StaticResource SecondaryButton}" Command="{Binding ClosePartitionPanelCommand}"/>
                            <TextBlock Text="🗂 Bölüm Analizi" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding PartitionSummary}" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                        <DataGrid ItemsSource="{Binding Partitions}" IsReadOnly="True" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"            Binding="{Binding Index}"      Width="35"/>
                                <DataGridTextColumn Header="Şema"         Binding="{Binding Scheme}"     Width="60"/>
                                <DataGridTextColumn Header="Tür"          Binding="{Binding TypeName}"   Width="*"/>
                                <DataGridTextColumn Header="Dosya Sistemi" Binding="{Binding FileSystem}" Width="95"/>
                                <DataGridTextColumn Header="Ad"           Binding="{Binding Name}"       Width="110"/>
                                <DataGridTextColumn Header="Başlangıç LBA" Binding="{Binding StartLba}"  Width="105"/>
                                <DataGridTextColumn Header="Boyut"        Binding="{Binding SizeText}"   Width="85" SortMemberPath="Size"/>
                                <DataGridTextColumn Header="Durum"        Binding="{Binding StatusText}" Width="170"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Dosya listesi DataGrid -->
                <DataGrid ItemsSource="{Binding FilteredFiles}"
                          SelectedItem="{Binding SelectedFileForPreview, Mode=TwoWay}"
                          SelectionMode="Single" IsReadOnly="False"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="☑" Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Dosya Adı" Width="*" SortMemberPath="FileName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <TextBlock Text="{Binding FileCategory, Converter={StaticResource CategoryIcon}}"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Tür"    Binding="{Binding FileCategory}" Width="75"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="Boyut"  Binding="{Binding SizeText}"     Width="85"  IsReadOnly="True" SortMemberPath="Size"/>
                        <DataGridTextColumn Header="Tarih"  Binding="{Binding DateText}"     Width="120" IsReadOnly="True" SortMemberPath="DeletedDate"/>
                        <DataGridTemplateColumn Header="Kurtarılabilirlik" Width="115" SortMemberPath="RecoverabilityPercent">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RecoverabilityPercent, StringFormat={}%{0}}"
                                               FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{Binding RecoverabilityPercent,
                                               Converter={StaticResource RecoverabilityColor}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- SAĞ PANEL: Dosya Önizleme -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="📋 Dosya Önizleme"
                               FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <!-- Dosya seçilmemişse bilgi mesajı -->
                    <TextBlock Text="Önizleme için listeden bir dosya seçin."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" FontStyle="Italic"
                               Visibility="{Binding CurrentPreview,
                               Converter={StaticResource PreviewVis},
                               ConverterParameter=inverse}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPreview}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Önizleme içeriği -->
                    <StackPanel DataContext="{Binding CurrentPreview}"
                                Visibility="{Binding Converter={StaticResource PreviewVis}}">

                        <!-- Başlık -->
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{StaticResource AccentBrush}"/>

                        <!-- Resim önizleme (diskten okunan gerçek küçük resim) -->
                        <Border Background="#141420" CornerRadius="4" Padding="4" Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static models:PreviewType.Image}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Image Source="{Binding Content, Converter={StaticResource BitmapToImg}}"
                                   MaxHeight="220" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <!-- Metin önizleme -->
                        <TextBox Text="{Binding Content, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="NoWrap"
                                 MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11"
                                 Margin="0,0,0,8">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}"
                                                     Value="{x:Static models:PreviewType.Text}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Metadata listesi -->
                        <ItemsControl ItemsSource="{Binding Metadata}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                               FontSize="11" Margin="0,2"
                                               Foreground="{StaticResource TextBrush}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══ Carving toggle satırı ═══ -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,5">
            <CheckBox Content="Veri Kazıma seçeneklerini göster (imza tabanlı tarama formatları)"
                      IsChecked="{Binding ShowCarvingOptions, Mode=TwoWay}"
                      Foreground="{StaticResource MutedBrush}"/>
        </Border>

        <!-- ═══ Alt panel: İlerleme + Hedef + Kurtarma ═══ -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0" Value="{Binding ScanProgress, Mode=OneWay}"/>
                <TextBlock   Grid.Row="1" Text="{Binding StatusMessage}" Margin="0,6" TextWrapping="Wrap"
                             Foreground="{StaticResource MutedBrush}"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Hedef klasör:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox   Grid.Column="1" Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"
                               VerticalAlignment="Center"/>
                    <Button    Grid.Column="2" Content="📂 Gözat" Style="{StaticResource SecondaryButton}"
                               Command="{Binding BrowseDestinationCommand}"/>
                    <Button    Grid.Column="3" Content="Seçilenleri Kurtar 💾"
                               Command="{Binding RecoverCommand}" FontWeight="SemiBold"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
